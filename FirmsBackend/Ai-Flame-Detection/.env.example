# ==============================================================================
# SIH 2026 - AI Flame Detection & Flare Intelligence System (SIH26162)
# Environment Variables & Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MAP & VISUALIZATION SERVICES (Frontend)
# ------------------------------------------------------------------------------
# MapTiler API Key for high-resolution vector basemaps & satellite terrain
# Get your free key at: https://cloud.maptiler.com
NEXT_PUBLIC_MAPTILER_KEY=
VITE_MAPTILER_API_KEY=

# Optional: Custom Backend API Base URL (defaults to relative '/' or http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. SATELLITE THERMAL STREAMING (NASA FIRMS)
# ------------------------------------------------------------------------------
# NASA FIRMS Near-Real-Time (NRT) 32-character MAP_KEY for VIIRS & MODIS active fire pixels
# Request your free MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# (Fallback: Local SQLite firms_cache.db or cached historical passes if unset)
FIRMS_MAP_KEY=1f855e76a168a37d8423e9d1f2047e76
NASA_FIRMS_MAP_KEY=1f855e76a168a37d8423e9d1f2047e76
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api
FIRMS_TIMEOUT_SECONDS=15.0
FIRMS_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 3. BACKEND & SECURITY (FastAPI / Uvicorn)
# ------------------------------------------------------------------------------
# Operational cryptographic secret key for signing tokens and sessions (min 32 chars in prod)
SECRET_KEY=sih26162-dev-secret-key-change-in-prod-with-high-entropy
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
PORT=8000

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION (PostgreSQL + PostGIS)
# ------------------------------------------------------------------------------
POSTGRES_DB=sih26162
POSTGRES_USER=sih_user
POSTGRES_PASSWORD=sih_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
ALLOW_FIXTURE_FALLBACK_IN_PROD=false

# Optional direct connection URL:
# DATABASE_URL=postgresql+psycopg://sih_user:sih_dev_password@localhost:5432/sih26162

# ------------------------------------------------------------------------------
# 5. EMERGENCY NOTIFICATION & DISPATCH
# ------------------------------------------------------------------------------
NOTIFICATION_MODE=simulation
SMS_PROVIDER=fast2sms
WHATSAPP_PROVIDER=richautomate
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_BASE_URL=https://www.fast2sms.com/dev/bulkV2
RICHAUTOMATE_API_KEY=your_richautomate_api_key_here
RICHAUTOMATE_BASE_URL=https://richautomate.in/api/v1
RICHAUTOMATE_ENABLED=true
EMERGENCY_RESPONSE_ENABLED=true
EMERGENCY_AUTO_ESCALATION_ENABLED=true
EMERGENCY_REVIEW_MIN_CONFIDENCE=0.94
EMERGENCY_AUTO_ESCALATION_MIN_CONFIDENCE=0.98

# ------------------------------------------------------------------------------
# 6. AGNI AI VOICE COMMAND INTERPRETATION
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
